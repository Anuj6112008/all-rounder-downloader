{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "name": "all-rounder-downloader",
  "builds": [
    { "src": "api/index.py", "use": "@vercel/python" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "no-referrer",
        "X-Frame-Options": "DENY",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
        "X-Powered-By": "IGDesk Downloader"
      }
    },
    {
      "src": "/sw.js",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate",
        "Service-Worker-Allowed": "/"
      }
    },
    {
      "src": "/manifest.webmanifest",
      "headers": {
        "Content-Type": "application/manifest+json"
      }
    },
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "src": "/about", "status": 308, "headers": { "Location": "/about.html" } },
    { "src": "/about/", "status": 308, "headers": { "Location": "/about.html" } },
    { "src": "/faq", "status": 308, "headers": { "Location": "/faq.html" } },
    { "src": "/faq/", "status": 308, "headers": { "Location": "/faq.html" } },
    { "src": "/terms", "status": 308, "headers": { "Location": "/terms.html" } },
    { "src": "/terms/", "status": 308, "headers": { "Location": "/terms.html" } },
    { "src": "/privacy", "status": 308, "headers": { "Location": "/privacy.html" } },
    { "src": "/privacy/", "status": 308, "headers": { "Location": "/privacy.html" } },
    { "src": "/dmca", "status": 308, "headers": { "Location": "/dmca.html" } },
    { "src": "/dmca/", "status": 308, "headers": { "Location": "/dmca.html" } },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
