# Environment variables for IGDesk Downloader (copy to .env and edit).
# NEVER commit real secrets. This app uses no API keys by design.

# Origins allowed by CORS (comma separated). Production origin is added on deploy.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:8000,http://localhost:8000

# Hard limits
MAX_FILE_BYTES=314572800        # 300 MB
MAX_DURATION_SECONDS=1200       # 20 minutes
JOB_BUDGET_SECONDS=240          # per-download wall-clock budget

# Rate limits (per IP, per minute, best effort on serverless)
RATE_LIMIT_INFO_PER_MIN=30
RATE_LIMIT_DOWNLOAD_PER_MIN=10
RATE_LIMIT_THUMB_PER_MIN=20

# Info cache TTL (seconds, in-memory, per warm instance)
INFO_CACHE_TTL=120

# Media pipeline: set to 0 to force every download through the proxy path
ALLOW_DIRECT_REDIRECT=1

# Optional: point at a specific ffmpeg binary. Otherwise the bundled
# imageio-ffmpeg static build (or PATH) is used. Never hardcode in code.
# FFMPEG_PATH=/usr/bin/ffmpeg
